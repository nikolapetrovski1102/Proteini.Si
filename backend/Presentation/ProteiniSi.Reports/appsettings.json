{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Marketing": {
    "Enabled": false,
    "AllowedRecipients": "",
    "RedirectAllTo": "",
    "TimeZone": "Europe/Skopje",
    "WindowHours": 3,
    "CapHours": 20,
    "MaxPerRun": 200,
    "SendDelayMs": 1500
  },
  "DailyReport": {
    "TimeZone": "Europe/Skopje",
    "IncludeSuperAdmins": true,
    "AdminRecipients": "",
    "ExcludeRecipients": "",
    "DeveloperRecipients": "",
    "Server": {
      "Services": [ "proteinisi-api-prod", "proteinisi-api-stage", "nginx", "docker" ],
      "Containers": [ "mssql" ],
      "Endpoints": {
        "Prod API": "http://127.0.0.1:6800/",
        "Stage API": "http://127.0.0.1:6801/",
        "proteini.mk": "https://proteini.mk/",
        "stage.proteini.mk": "https://stage.proteini.mk/"
      },
      "CertificateHosts": [ "proteini.mk", "stage.proteini.mk" ],
      "LogFolders": {
        "prod": "/srv/proteinisi/prod/api/logs",
        "stage": "/srv/proteinisi/stage/api/logs"
      },
      "NginxAccessLogs": [ "/var/log/nginx/access.log", "/var/log/nginx/access.log.1" ],
      "NginxErrorLog": "/var/log/nginx/error.log",
      "Disks": [ "/" ]
    }
  }
}
