{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/proteinisi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "CPayConfiguration": {
    "PayToMerchant": "",
    "MerchantName": "",
    "SecretKey": "",
    "Currency": "MKD",
    "Language": "mk-MK",
    "SuccessUrl": "http://localhost:5173/payment/success",
    "FailureUrl": "http://localhost:5173/payment/failure",
    "TestMode": true
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://proteini.mk",
      "https://www.proteini.mk"
    ]
  },
  "AppSettings": {
    "PasswordKey": "",
    "TokenKey": "",
    "ClientKey": "",
    "FrontendUrl": "http://localhost:5173",
    "BackendUrl": "http://localhost:6800"
  },
  "MailSettings": {
    "sender_email": "",
    "sender_username": "",
    "sender_password": "",
    "host": "",
    "SMTPPort": 587,
    "EnableSsl": true,
    "CheckCertificateRevocation": true,
    "sender_name": "Proteini.mk",
    "DiagnosticsKey": "",
    "OrderNotificationEmail": "",
    "SellerRecipients": [],
    "OrderCopyRecipients": []
  }
}
