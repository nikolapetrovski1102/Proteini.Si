# Copy to .env.development (vite dev) and .env.production (vite build).
# VITE_* values are embedded in the client bundle; never put server secrets here.

# Backend API base URL, including the /api suffix.
VITE_API_BASE_URL=http://localhost:6800/api

# Must match AppSettings:ClientKey in the API. It ships in the bundle, so it only
# keeps casual scripts and bots out; user endpoints still rely on the JWT.
VITE_API_CLIENT_KEY=REPLACE_WITH_RANDOM_CLIENT_KEY

# Origin that serves uploaded images (e.g. /img/...).
VITE_IMAGE_BASE_URL=https://proteini.mk

# Public browser key for the Google Maps Embed API.
# Restrict the key to the intended website origins and Maps Embed API.
VITE_GOOGLE_MAPS_EMBED_API_KEY=REPLACE_WITH_RESTRICTED_BROWSER_KEY
