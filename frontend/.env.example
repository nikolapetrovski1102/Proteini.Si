# Copy to .env.development (vite dev) and .env.production (vite build).
# VITE_* values are embedded in the client bundle; never put server secrets here.

# Backend API base URL, including the /api suffix.
VITE_API_BASE_URL=http://localhost:6800/api

# Must match AppSettings:ClientKey in the API. It ships in the bundle, so it only
# keeps casual scripts and bots out; user endpoints still rely on the JWT.
VITE_API_CLIENT_KEY=REPLACE_WITH_RANDOM_CLIENT_KEY

# Origin that serves uploaded images (e.g. /img/...).
VITE_IMAGE_BASE_URL=https://proteini.mk


# Dev only: `vite dev` proxies /api and upload folders to this backend (avoids CORS).
# Pair it with VITE_API_BASE_URL=/api, e.g. DEV_API_PROXY_TARGET=https://stage.proteini.mk
# DEV_API_PROXY_TARGET=

# Sign-in with Google. Leave empty to hide that button.
# Google: OAuth "Web application" client id; add every site origin under Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Meta (Facebook/Instagram) Pixel ID from Events Manager. Empty = pixel off.
VITE_META_PIXEL_ID=

# Cloudflare Turnstile ("I'm not a robot") on checkout. Empty = check off.
# Pair with Turnstile:SecretKey in the API; add every site hostname to the widget in Cloudflare.
VITE_TURNSTILE_SITE_KEY=
